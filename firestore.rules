rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is Julio (Admin)
    function isJulio() {
      return request.auth != null && (
        request.auth.token.email == 'juliozaldivar@gmail.com' ||
        request.auth.uid == 'default' ||
        request.auth.uid == 'user-julio'
      );
    }

    // Boards collection: Public read & write for app sync and collaboration
    match /boards/{boardId} {
      allow read, write: if true;
    }

    // Users collection: Public read for friend search & avatars; profile updates
    match /users/{userId} {
      allow read, write: if true;
    }

    // Friends collection: Read & write for friend connections
    match /friends/{userId} {
      allow read, write: if true;
    }

    // User Activity tracking
    match /user_activity/{activityId} {
      allow read, write: if true;
    }

    // System configurations and backups
    match /system/{docId} {
      allow read, write: if true;
    }

    // Fallback rule for other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
